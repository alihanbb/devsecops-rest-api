{
  "name": "devsecops-rest-api",
  "version": "1.0.0",
  "description": "Production-oriented Express REST API with DevSecOps and CI/CD practices.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "lint": "eslint src tests *.js",
    "test": "jest --runInBand --ci",
    "test:coverage": "jest --runInBand --ci --coverage",
    "build": "node -e \"console.log('Build completed for Node.js runtime app')\""
  },
  "keywords": [
    "devsecops",
    "nodejs",
    "express",
    "rest",
    "cicd"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.64.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "envalid": "^8.1.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
